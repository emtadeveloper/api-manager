generator client {
  provider = "prisma-client-js"
  output   = "../generated/sqlite"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int     @id @default(autoincrement())
  // completed   Boolean @default(false)
  firstName String?
  lastName  String?
  username  String?
  password  String?

  @@map("users")
}

model DatabaseSetting {
  id         Int     @id @default(autoincrement())
  dbType     String? @map("db_type")
  dbServer   String? @map("db_server")
  dbPort     String? @map("db_port")
  dbUsername String? @map("db_username")
  dbPassword String? @map("db_password")
  dbName     String? @map("db_name")

  @@map("database_settings")
}

model RestService {
  id          Int     @id @default(autoincrement())
  persianName String? @map("persian_name")
  latinName   String? @unique() @map("latin_name")
  httpMethod  String? @map("http_method")
  restType    String? @map("rest_type")

  restDatabaseSetting    RestDatabaseSetting?
  restExternalApiSetting RestExternalApiSetting?
  restAuthServiceSetting RestAuthServiceSetting?

  @@map("rest_services")
}

model RestDatabaseSetting {
  id         Int     @id @default(autoincrement())
  dbType     String? @map("db_type")
  dbServer   String? @map("db_server")
  dbPort     String? @map("db_port")
  dbUsername String? @map("db_username")
  dbPassword String? @map("db_password")
  dbName     String? @map("db_name")
  dbViewName String? @map("db_view_name")

  restService    RestService @relation(fields: [restServiceRef], references: [id], onDelete: Cascade)
  restServiceRef Int         @unique @map("rest_service_ref")

  @@map("rest_database_settings")
}

model RestExternalApiSetting {
  id                   Int                    @id @default(autoincrement())
  baseUrl              String?                @map("base_url")
  // authServiceUrl    String?                @map("auth_service_url")
  // authUsername      String?                @map("auth_username")
  // authPassword      String?                @map("auth_password")
  // authUsernameParam String?                @map("auth_username_param")
  // authPasswordParam String?                @map("auth_password_param")
  hasAuth              Boolean?               @map("has_auth")
  restExternalApiParam RestExternalApiParam[]

  restService    RestService @relation(fields: [restServiceRef], references: [id], onDelete: Cascade)
  restServiceRef Int         @unique @map("rest_service_ref")

  @@map("rest_external_api_settings")
}

model RestAuthServiceSetting {
  id Int @id @default(autoincrement())

  authServiceUrl String?     @map("auth_service_url")
  // authUsername      String? @map("auth_username")
  // authPassword      String? @map("auth_password")
  // authUsernameParam String? @map("auth_username_param")
  // authPasswordParam String? @map("auth_password_param")
  authMethod     String?     @map("auth_method")
  restService    RestService @relation(fields: [restServiceRef], references: [id], onDelete: Cascade)
  restServiceRef Int         @unique @map("rest_service_ref")

  restAuthServiceParam RestAuthServiceParam[]

  @@map("rest_auth_service_settings")
}

model RestAuthServiceParam {
  id Int @id @default(autoincrement())

  paramType  String? @map("param_type")
  paramName  String? @map("param_name")
  paramValue String? @map("param_value")

  restAuthServiceSetting    RestAuthServiceSetting @relation(fields: [restAuthServiceSettingRef], references: [id], onDelete: Cascade)
  restAuthServiceSettingRef Int                    @map("rest_auth_service_ref")

  @@map("rest_auth_service_param")
}

model RestExternalApiParam {
  id Int @id @default(autoincrement())

  paramType  String? @map("param_type")
  paramName  String? @map("param_name")
  paramValue String? @map("param_value")

  restExternalApi    RestExternalApiSetting @relation(fields: [restExternalApiRef], references: [id], onDelete: Cascade)
  restExternalApiRef Int                    @map("rest_external_api_ref")

  @@map("rest_external_api_param")
}
