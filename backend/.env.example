NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
SQLITE_DATABASE_PATH=./data/ApiManagerDB.sqlite3

# TypeORM database settings (only needed for MySQL/PostgreSQL)
DB_TYPE=better-sqlite3
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api-manager
DB_USERNAME=postgres
DB_PASSWORD=change-me

# حداقل ۳۲ کاراکتر؛ این مقدار را در محیط واقعی تغییر دهید.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-second-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# فقط برای محیط توسعه؛ در production خاموش باشد.
TYPEORM_SYNCHRONIZE=true
